generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetKind {
  IMAGE
  VIDEO
  FILE
}

enum AssetSource {
  CLOUDINARY
  EXTERNAL
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  DECLINED
  ARCHIVED
}

enum CareerType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum CategoryKind {
  NEWS
  PROGRAM
}

enum ProgramApplicationMethod {
  EMAIL
  EXTERNAL_LINK
  BUILT_IN_FORM
}

enum ParticipantGoalStatus {
  NOT_REVIEWED
  IN_PROGRESS
  ACHIEVED
  PAUSED
}

enum ParticipantStatus {
  ONGOING
  ALUMNI
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  firstName            String
  lastName             String
  password             String
  role                 UserRole  @default(EDITOR)
  active               Boolean   @default(true)
  requirePasswordReset Boolean   @default(false)
  totpEnabled          Boolean   @default(false)
  totpSecret           String?
  totpPendingSecret    String?
  backupCodes          String[]  @default([])
  lastLogin            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions  Session[]
  passkeys  PasskeyCredential[]
  challenges AuthChallenge[]
  assets    Asset[]   @relation("AssetUploadedBy")

  @@index([role])
  @@index([active])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

enum AuthChallengeType {
  LOGIN_2FA
  PASSWORD_RESET
  PASSKEY_REGISTER
  PASSKEY_LOGIN
}

model AuthChallenge {
  id         String            @id @default(uuid())
  userId     String?
  email      String
  type       AuthChallengeType
  codeHash   String            @default("")
  token      String            @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int               @default(0)
  verifiedAt DateTime?
  metadata   Json?
  createdAt  DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([type])
  @@index([expiresAt])
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Asset {
  id               String      @id @default(uuid())
  source           AssetSource @default(CLOUDINARY)
  kind             AssetKind   @default(IMAGE)
  publicId         String?     @unique
  url              String
  urlRaw           String?
  title            String?
  alt              String?
  description      String?
  folder           String?
  originalFilename String?
  mimeType         String?
  width            Int?
  height           Int?
  format           String?
  bytes            Int?
  tags             String[]    @default([])
  active           Boolean     @default(true)
  uploadedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  uploadedBy User? @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  programImages            Program[]    @relation("ProgramImage")
  programBanners           Program[]    @relation("ProgramBanner")
  programBrochures         Program[]    @relation("ProgramBrochure")
  programBrochurePreviews  Program[]    @relation("ProgramBrochurePreview")
  teamImages               TeamMember[] @relation("TeamImage")
  partnerLogos         Partner[]    @relation("PartnerLogo")
  postFeaturedImages   Post[]       @relation("PostFeaturedImage")
  postBannerImages     Post[]       @relation("PostBannerImage")
  settingsLogo         WebsiteSettings[] @relation("SettingsLogo")
  identityHero         OrganizationIdentity[] @relation("IdentityHero")
  programGallery       ProgramGalleryImage[]
  programOgImages      Program[]    @relation("ProgramOgImage")
  outcomeImages        ProgramOutcome[] @relation("OutcomeImage")
  activityImages       ProgramActivity[] @relation("ActivityImage")
  testimonialPhotos    ProgramTestimonial[] @relation("TestimonialPhoto")
  testimonialVideos    ProgramTestimonial[] @relation("TestimonialVideo")
  participantPhotos    ProgramParticipant[] @relation("ParticipantPhoto")
  participantUpdateAttachments ProgramParticipantUpdate[] @relation("ParticipantUpdateAttachment")

  @@index([kind])
  @@index([active])
  @@index([createdAt])
  @@index([folder])
}

model ContentCategory {
  id          String       @id @default(uuid())
  kind        CategoryKind
  name        String
  slug        String
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([kind, slug])
  @@index([kind, sortOrder])
  @@index([kind, name])
}

model WebsiteSettings {
  id             String  @id @default("default")
  siteName       String  @default("African Leaders Hub")
  tagline        String  @default("Building Africa's Future through People, Purpose, and Possibility")
  addressLine1   String?
  addressLine2   String?
  city           String  @default("Kigali")
  country        String  @default("Rwanda")
  phonePrimary   String?
  phoneSecondary String?
  emailPrimary   String?
  emailSecondary String?
  businessHours  String?
  mapEmbedUrl    String?
  socialLinks    Json    @default("[]")
  logoAssetId    String?
  logoAsset      Asset?  @relation("SettingsLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}

model OrganizationIdentity {
  id            String   @id @default("default")
  mission       String   @default("")
  vision        String   @default("")
  background    String   @default("")
  values        Json     @default("[]")
  heroAssetId   String?
  heroAsset     Asset?   @relation("IdentityHero", fields: [heroAssetId], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt
}

model LegalPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String?
  contentHtml     String   @default("")
  contentJson     Json?
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Program {
  id                           String                     @id @default(uuid())
  slug                         String                     @unique
  title                        String
  category                     String
  description                  String
  descriptionHtml              String                     @default("")
  descriptionJson              Json?
  showDescription              Boolean                    @default(true)
  showJourney                  Boolean                    @default(false)
  testimonialsHtml             String                     @default("")
  testimonialsJson             Json?
  showTestimonials             Boolean                    @default(false)
  timelineHtml                 String                     @default("")
  timelineJson                 Json?
  imageAssetId                 String?
  bannerAssetId                String?
  brochureAssetId              String?
  brochurePreviewAssetId       String?
  imageAsset                   Asset?                     @relation("ProgramImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  bannerAsset                  Asset?                     @relation("ProgramBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)
  brochureAsset                Asset?                     @relation("ProgramBrochure", fields: [brochureAssetId], references: [id], onDelete: SetNull)
  brochurePreviewAsset         Asset?                     @relation("ProgramBrochurePreview", fields: [brochurePreviewAssetId], references: [id], onDelete: SetNull)
  partners                     Partner[]
  galleryImages                ProgramGalleryImage[]
  status                       ContentStatus              @default(PUBLISHED)
  featured                     Boolean                    @default(false)
  sortOrder                    Int                        @default(0)
  applicationsEnabled          Boolean                    @default(false)
  applicationsOpenAt           DateTime?
  applicationsCloseAt          DateTime?
  applicationMethod            ProgramApplicationMethod?
  applicationEmail             String?
  applicationUrl               String?
  applicationGuidelinesHtml    String                     @default("")
  applicationGuidelinesJson    Json?
  seoTitle                     String?
  seoDescription               String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  applications                 ProgramApplication[]
  duration                     String                     @default("")
  showTimeline                 Boolean                    @default(true)
  showGallery                  Boolean                    @default(true)
  showParticipants             Boolean                    @default(true)
  showAlumni                   Boolean                    @default(false)
  ogTitle                      String?
  ogDescription                String?
  ogImageAssetId               String?
  ogImageAsset                 Asset?                     @relation("ProgramOgImage", fields: [ogImageAssetId], references: [id], onDelete: SetNull)
  objectivesManaged            ProgramObjective[]
  outcomes                     ProgramOutcome[]
activities                   ProgramActivity[]
  timelinePhases               ProgramTimelinePhase[]
  testimonials                 ProgramTestimonial[]
  participants                 ProgramParticipant[]
  journeyStages                ProgramJourneyStage[]

  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([applicationsEnabled])
}

model TeamMember {
  id               String     @id @default(uuid())
  slug             String     @unique
  name             String
  position         String
  committee        String?
  responsibilities String?
  biography        String?
  nationality      String?
  linkedin         String?
  twitter          String?
  facebook         String?
  instagram        String?
  imageAssetId     String?
  imageAsset       Asset?     @relation("TeamImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  status           TeamStatus @default(ACTIVE)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([committee])
  @@index([status])
  @@index([sortOrder])
}

model Partner {
  id          String    @id @default(uuid())
  name        String
  category    String
  website     String?
  logoAssetId String?
  logoAsset   Asset?    @relation("PartnerLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  programs    Program[]

  @@index([category])
  @@index([published])
  @@index([sortOrder])
}

model ProgramGalleryImage {
  id          String  @id @default(uuid())
  programId   String
  assetId     String
  caption     String  @default("")
  description String  @default("")
  altText     String  @default("")
  category    String  @default("")
  featured    Boolean @default(false)
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([programId, published, sortOrder])
  @@index([programId, sortOrder])
  @@index([assetId])
}

model ProgramObjective {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String   @default("")
  theme       String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, published, sortOrder])
}

model ProgramOutcome {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String   @default("")
  icon        String   @default("")
  imageAssetId String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  imageAsset  Asset?   @relation("OutcomeImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, published, sortOrder])
}

model ProgramActivity {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String   @default("")
  theme       String   @default("")
  period      String   @default("")
  startDate   DateTime?
  endDate     DateTime?
  imageAssetId String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  imageAsset  Asset?   @relation("ActivityImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, published, sortOrder])
}

model ProgramJourneyStage {
  id          String   @id @default(uuid())
  programId   String
  title       String
  activities  String[] @default([])
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
@@index([programId, published, sortOrder])
}

model ProgramTimelinePhase {
  id          String   @id @default(uuid())
  programId   String
  name        String
  description String   @default("")
  startDate   DateTime?
  endDate     DateTime?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  milestones  ProgramTimelineMilestone[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, published, sortOrder])
}

model ProgramTimelineMilestone {
  id          String   @id @default(uuid())
  phaseId     String
  title       String
  description String   @default("")
  date        DateTime?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  phase       ProgramTimelinePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phaseId, published, sortOrder])
}

model ProgramTestimonial {
  id             String   @id @default(uuid())
  programId      String
  name           String
  role           String   @default("")
  organization   String   @default("")
  content        String
  location       String   @default("")
  photoAssetId   String?
  mediaAssetId   String?
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  participantId  String?
  storyTitle     String?
  excerpt        String   @default("")
  slug           String?  @unique
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  photoAsset     Asset?   @relation("TestimonialPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)
  mediaAsset     Asset?   @relation("TestimonialVideo", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  participant    ProgramParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([programId, published, featured, sortOrder])
  @@index([participantId])
  @@index([mediaAssetId])
}

model ProgramParticipant {
  id          String   @id @default(uuid())
  programId   String
  name        String
  projectName String   @default("")
  businessDescription String @default("")
  sector      String   @default("")
  socialMedia String   @default("")
  challengesBefore String @default("")
  achievements String @default("")
  status      ParticipantStatus @default(ONGOING)
  biography   String   @default("")
  location    String   @default("")
  photoAssetId String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  photoAsset  Asset?   @relation("ParticipantPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)
  testimonials ProgramTestimonial[]
  goals       ProgramParticipantGoal[]
  updates     ProgramParticipantUpdate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, published, sortOrder])
}

model ProgramParticipantGoal {
  id             String                 @id @default(uuid())
  participantId  String
  title          String
  description    String                 @default("")
  status         ParticipantGoalStatus  @default(NOT_REVIEWED)
  progress       Int                    @default(0)
  achievementNotes String               @default("")
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  participant    ProgramParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, sortOrder])
  @@index([participantId, status])
}

model ProgramParticipantUpdate {
  id                   String             @id @default(uuid())
  participantId        String
  title                String
  occurredAt           DateTime           @default(now())
  progressDescription  String             @default("")
  achievements         String             @default("")
  challenges           String             @default("")
  nextSteps            String             @default("")
  internalNotes        String             @default("")
  attachmentAssetId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  participant          ProgramParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  attachmentAsset      Asset?             @relation("ParticipantUpdateAttachment", fields: [attachmentAssetId], references: [id], onDelete: SetNull)

  @@index([participantId, occurredAt])
}

model Donation {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  amount      Float
  message     String?
  anonymous    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([subscribedAt])
}

model ProgramApplication {
  id                 String            @id @default(uuid())
  programId          String?
  program            Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  email              String
  phone              String?
  location           String?
  motivation         String
  resumeAssetId      String?
  additionalAssetIds String[]          @default([])
  status             ApplicationStatus @default(NEW)
  adminNotes         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([programId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model ImpactStat {
  id          String   @id @default(uuid())
  title       String
  value       String
  description String
  category    String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([sortOrder])
}

model Post {
  id                 String        @id @default(uuid())
  slug               String        @unique
  title              String
  excerpt            String
  contentHtml        String        @default("")
  contentJson        Json?
  authorName         String        @default("African Leaders Hub")
  category           String
  tags               String[]      @default([])
  featuredImageId    String?
  bannerImageId      String?
  featuredImage      Asset?        @relation("PostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  bannerImage        Asset?        @relation("PostBannerImage", fields: [bannerImageId], references: [id], onDelete: SetNull)
  featured           Boolean       @default(false)
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  readTime           String?
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([category])
  @@index([publishedAt])
}

model Career {
  id                   String        @id @default(uuid())
  slug                 String        @unique
  title                String
  department           String
  location             String
  type                 CareerType    @default(FULL_TIME)
  description          String
  detailsHtml          String        @default("")
  detailsJson          Json?
  applicationDeadline  DateTime?
  postedAt             DateTime      @default(now())
  featured             Boolean       @default(false)
  status               ContentStatus @default(PUBLISHED)
  applyEmail           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  applications         CareerApplication[]

  @@index([slug])
  @@index([status])
  @@index([department])
  @@index([type])
  @@index([postedAt])
}

model CareerApplication {
  id                 String            @id @default(uuid())
  careerId           String?
  career             Career?           @relation(fields: [careerId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  email              String
  phone              String?
  coverLetter        String?
  resumeAssetId      String?
  coverLetterAssetId String?
  additionalAssetIds String[]          @default([])
  additionalInfo     String?
  status             ApplicationStatus @default(NEW)
  adminNotes         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([careerId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model VolunteerApplication {
  id           String            @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  location     String
  skills       String
  interest     String
  availability String
  motivation   String
  status       ApplicationStatus @default(NEW)
  adminNotes   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model PartnershipApplication {
  id                  String            @id @default(uuid())
  orgName             String
  orgType             String
  contactName         String
  contactEmail        String
  contactPhone        String
  orgLocation         String
  orgDescription      String
  partnershipInterest String
  partnershipGoals    String
  status              ApplicationStatus @default(NEW)
  adminNotes          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

model ContactInquiry {
  id           String            @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  subject      String
  organization String?
  message      String
  newsletter   Boolean           @default(false)
  status       ApplicationStatus @default(NEW)
  adminNotes   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model DonationInquiry {
  id         String            @id @default(uuid())
  firstName  String
  lastName   String
  email      String
  phone      String?
  amount     String?
  message    String?
  status     ApplicationStatus @default(NEW)
  adminNotes String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}
